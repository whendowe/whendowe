# WhenDoWe configuration — placeholder values only.
# Real values live in GitHub Environments / `wrangler secret` (DESIGN.md §13);
# nothing secret or instance-specific may ever enter this repo.

# Node deployment (deploy/node)
PORT=8080
DATABASE_URL=file:data/whendowe.db
LOG_LEVEL=info

# Google Calendar OAuth (DESIGN.md §12).
# Create a Web application OAuth client in your own Google Cloud project; the
# consent screen stays in "testing" for the MVP (≤100 test users, no
# verification). Scopes requested are calendar + calendar.events only.
# GOOGLE_REDIRECT_URI must match a redirect URI registered on that client
# exactly, including scheme, port and path.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# AES-256-GCM key wrapping the stored OAuth tokens and calendar feed links
# (DESIGN.md §13, §10 rc34): base64 of 32 random bytes. Google needs it; feeds need
# it too, so set it even without Google, or the instance offers no feeds. Generate
# one per instance and never commit it — and note §13's rule that it must NOT live
# in the same store as the encrypted rows.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me-with-base64-of-32-random-bytes

# Sign-in links are built from this origin — NEVER from the request's Host header
# (a forged Host would otherwise make the app email login links to an attacker's
# domain). Must be the address people actually reach the instance at.
PUBLIC_BASE_URL=http://localhost:8080

# Outbound mail (DESIGN §13 rc9).
#   disabled   — the default: refuses to send (fail closed)
#   console    — prints each message, sign-in links included, to the terminal.
#                For local development ONLY: in production it writes working
#                login links into your logs.
#   cloudflare — Cloudflare Email Service (Workers binding when hosted, REST on Node)
MAIL_PROVIDER=console
MAIL_FROM_ADDRESS=login@notify.example.org
MAIL_FROM_NAME=WhenDoWe
# Hard caps, enforced in the app before every send. The defaults sit under the
# 3,000 sends/month Workers Paid includes, so they cannot incur overage.
MAIL_DAILY_CAP=200
MAIL_MONTHLY_CAP=2500
# One sender's share of those caps, for mail they cause to other addresses, and a new
# account's smaller daily share for its first days after it first signs in. Unset, they
# are a quarter of the daily cap, a fifth of the monthly one, and 20 a day for 7 days.
# MAIL_SENDER_DAILY_CAP=50
# MAIL_SENDER_MONTHLY_CAP=500
# MAIL_NEW_SENDER_DAILY_CAP=20
# MAIL_NEW_SENDER_DAYS=7
# REST path only (Node self-host). Hosted Workers instances use a binding instead.
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_EMAIL_API_TOKEN=replace-me
