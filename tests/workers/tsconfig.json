{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "./**/*.ts",
    // Every contract suite runs in workerd too; a glob means a new suite cannot be
    // forgotten here (and stops parallel PRs colliding on this list).
    "../contract/*.suite.ts",
    "../../src/**/*.ts"
  ],
  "exclude": [
    // Node-only storage driver; workerd tests exercise src/db/d1.ts instead.
    "../../src/db/sqlite.ts"
  ]
}
